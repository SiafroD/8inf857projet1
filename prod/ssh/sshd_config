Port 22
PermitRootLogin no
PasswordAuthentication yes
PubkeyAuthentication yes
# VERBOSE adds the key fingerprint of a successful login, which the persistence
# scenario needs; the brute-force lines ("Failed password for ...") are at INFO.
LogLevel VERBOSE
UsePAM yes
Subsystem sftp /usr/lib/openssh/sftp-server

# Lab: let the full brute-force burst reach sshd so Wazuh composite rule 5712 fires
# (OpenSSH 9.x throttles a source after a few failures, which hides the burst).
PerSourcePenalties no
