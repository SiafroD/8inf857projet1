<group name="ids,suricata,">

  <!-- The team's own signatures, prod/suricata/local.rules (sid 1000001 to 1000005). -->
  <rule id="100300" level="10">
    <if_sid>86601</if_sid>
    <field name="alert.signature_id">^100000\d$</field>
    <description>Suricata (SOC): $(alert.signature)</description>
  </rule>

  <!-- Not alert.severity: it comes from the classtype, and policy rules such as
       ET INFO Outgoing Basic Auth (2006380) get 1, the highest. ET rates each rule
       in its metadata instead, Informational for those. -->
  <rule id="100301" level="10">
    <if_sid>86601</if_sid>
    <field name="alert.metadata.signature_severity">Major|Critical</field>
    <description>Suricata (ET major or critical): $(alert.signature)</description>
  </rule>

</group>

<group name="postgresql,">

  <rule id="100500" level="0">
    <decoded_as>postgresql</decoded_as>
    <description>PostgreSQL log message.</description>
  </rule>

  <!-- Role DDL is logged only because of log_statement=ddl; a new login role is a
       classic database-persistence foothold. -->
  <rule id="100501" level="10">
    <if_sid>100500</if_sid>
    <match>CREATE ROLE|CREATE USER|ALTER ROLE|ALTER USER</match>
    <description>PostgreSQL: role created or altered - possible backdoor account.</description>
    <mitre>
      <id>T1136.001</id>
    </mitre>
  </rule>

  <rule id="100502" level="12">
    <if_sid>100501</if_sid>
    <match>SUPERUSER</match>
    <description>PostgreSQL: SUPERUSER role created or altered - privileged database backdoor.</description>
    <mitre>
      <id>T1136.001</id>
      <id>T1078.001</id>
    </mitre>
  </rule>

</group>
